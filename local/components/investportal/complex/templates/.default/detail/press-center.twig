{{ include_component("investportal:main.block", "detailnews", {
    'IS_EMPTY': true
}) }}

<section class="section section_padding-m">
    <div class="wrapper wrapper_mode-s">
        <h1 class="headline headline_size-h1">
            {{ arResult['ITEM']['NAME'] }}
        </h1>
        <span class="news-item__date news-item__date-icon description_size-p1">
            {{ arResult['ITEM']['ACTIVE_FROM']|split(' ')|first }}
    </span>
    </div>
</section>

<section class="section section_padding-s section_padding-top-none">
    <div class="wrapper wrapper_mode-l">
        <div class="news-page__image image-container image-container_bg full-image"
             style="background-image: url({{ get_src_by_id(arResult['ITEM']['PREVIEW_PICTURE']) }})"></div>
    </div>
</section>

<section class="section section_padding-s section_padding-top-none">
    <div class="wrapper wrapper_mode-s">
        <div class="description description_size-p1 description_padding-bottom-none">
            {{ arResult['ITEM']['DETAIL_TEXT'] | raw}}
        </div>
    </div>
</section>


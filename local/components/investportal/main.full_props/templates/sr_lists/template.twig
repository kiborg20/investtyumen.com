{% if arResult['ITEMS'] %}
    {% for item in arResult['ITEMS'] %}
    <section class="section section_padding-xl">
        <div class="wrapper wrapper_mode-l">
            <div class="block__limited-width-m">
                <div class="headline headline_size-h2">{{ item['NAME'] }} </div>

                <div class="description description_size-p1">{{ item['PREVIEW_TEXT'] }}</div>
            </div>

            <div class="table">
                {% for prop in item['PROP']['list'] %}
                <div class="table__item">
                    <div class="table__left">
                        <div class="headline headline_size-h5">{{ prop['desc'] }}</div>
                    </div>

                    <div class="table__right">
                        <div class="headline headline_size-h5 headline_color-blue">{{ prop['value'] | raw }}</div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endfor %}
{% endif %}
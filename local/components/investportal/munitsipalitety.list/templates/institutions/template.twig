<section class="section section_padding-xl">
    <div class="wrapper wrapper_mode-l">
        <div class="headline headline_size-h2">10+ научных и проектных институтов</div>
        <div class="description description_size-p1">покрывающие все основные направления исследований</div>
        <div class="logotype-list">
            {% for item in arResult['ITEMS'] %}
            <div class="logotype-list__item">
                <div class="logotype-list__image"><img alt="" src="{{ item.PREVIEW_PICTURE }}" /></div>

                <div class="logotype-list__text"><div class="description description_size-p1 description_padding-none">{{ item.NAME }}</div></div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
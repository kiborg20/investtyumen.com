<section class="section section_padding-xl">
    <div class="wrapper wrapper_mode-l">
        <div class="block__limited-width-m no-margin">
            <h2 class="headline headline_size-h2">Межрегиональное сотрудничество</h2>
            <p class="description description_size-p1 description_padding-bottom-none">
                Развитие межрегионального сотрудничества в современных условиях обеспечено принятием комплекса правовых, финансовых, организационных мер на федеральном, региональном и муниципальном уровнях.
            </p>
        </div>

        <div class="regions-grid grid">
            <div class="grid__row grid__header">
                <div class="grid__cell description description_padding-none description_size-p2">
                    Партнёр
                </div>
                <div class="grid__cell description description_padding-none description_size-p2">
                    Наименование документа
                </div>
                <div class="grid__cell description description_padding-none description_size-p2">
                    Дата
                </div>
                <div class="grid__cell description description_padding-none description_size-p2">
                    Срок действия
                </div>
            </div>

            {% for item in arResult['ITEMS'] %}
            <div class="grid__row">
                <div class="grid__cell description strong description_padding-none description_size-p2">
                    {{ item['NAME'] }}
                </div>
                <div class="grid__cell document-name__cell description description_padding-none description_size-p2">
                    {{ item['PREVIEW_TEXT'] }}
                    <button class="button button_theme-white button_size-s">
                        <div class="button__icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12.7501 13.1893L15.9394 10C16.2323 9.70712 16.7071 9.70712 17 10C17.2929 10.2929 17.2929 10.7678 17 11.0607L12.5304 15.5303C12.3897 15.671 12.199 15.75 12.0001 15.75C11.8011 15.75 11.6104 15.671 11.4697 15.5303L7.00006 11.0606C6.70717 10.7678 6.70717 10.2929 7.00006 9.99998C7.29296 9.70708 7.76783 9.70708 8.06072 9.99998L11.2501 13.1893V2.75C11.2501 2.72411 11.2514 2.69853 11.2539 2.67332C11.2923 2.29513 11.6117 2 12.0001 2C12.4143 2 12.7501 2.33579 12.7501 2.75V13.1893Z" fill="#252830"/>
                                <path d="M4.75 14.7503C4.75 14.336 4.41421 14.0003 4 14.0003C3.58578 14.0003 3.25 14.336 3.25 14.7503V19.0002C3.25 19.9667 4.0335 20.7502 5 20.7502H19C19.9665 20.7502 20.75 19.9667 20.75 19.0002V14.7503C20.75 14.336 20.4142 14.0003 20 14.0003C19.5858 14.0003 19.25 14.336 19.25 14.7503V19.0002C19.25 19.1383 19.138 19.2502 19 19.2502H5C4.86193 19.2502 4.75 19.1383 4.75 19.0002V14.7503Z" fill="#252830"/>
                            </svg>
                        </div>
                    </button>
                </div>
                <div class="grid__cell description description_padding-none description_size-p2">
                    {{ item['DETAIL_TEXT'] }}
                </div>
                <div class="grid__cell description description_padding-none description_size-p2">
                    {{ item['validity']['PROPERTY_VALUE'] }}
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
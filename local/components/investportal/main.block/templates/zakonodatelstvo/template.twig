{% if arResult['IS_AJAX'] is empty%}
<section class="section section_padding-s">
    <div class="wrapper wrapper_mode-l">
        <div class="documents-filter-panel">
            <form id="search-documents-form">

                <div class="documents-search-row">
                    <div class="documents-search">

                        <div class="documents-search__wrapper">
                            <div class="documents-search__block">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none">
                                    <path fill="currentColor" fill-rule="evenodd" d="M10.54 3a7.54 7.54 0 1 0 4.667 13.461l4.279 4.28a.887.887 0 0 0 1.254-1.255l-4.279-4.28A7.54 7.54 0 0 0 10.54 3Zm-5.766 7.54a5.766 5.766 0 1 1 11.531 0 5.766 5.766 0 0 1-11.531 0Z" clip-rule="evenodd"/>
                                </svg>

                                <input class="documents-search__input" type="text" name="search" placeholder="Найти документы по заголовку" />
                            </div>

                            <div class="documents-search__button-clear">
                                <button class="button" type="button" data-search-input-clear>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none">
                                        <path fill="#252830" fill-rule="evenodd" d="M6.355 5.234a.791.791 0 0 0-1.123 0 .8.8 0 0 0 0 1.127l5.646 5.671-5.582 5.607a.8.8 0 0 0 0 1.127.791.791 0 0 0 1.123 0l5.582-5.606 5.582 5.606a.791.791 0 0 0 1.123 0 .8.8 0 0 0 0-1.127l-5.582-5.607 5.646-5.67a.8.8 0 0 0 0-1.128.791.791 0 0 0-1.123 0L12 10.904l-5.646-5.67Z" clip-rule="evenodd"/>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <button data-search-input-submit class="button button_size-m button_theme-blue" type="button">
                            Найти
                        </button>

                    </div>

                    <button data-btn-extra-search-params class="button button_theme-transparent button_padding-none documents-filter-button" type="button">
                        Расширенный поиск
                        <svg xmlns="http://www.w3.org/2000/svg" width="12" height="7" fill="none">
                            <path stroke="#4A66F5" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 1 6 6 1 1"/>
                        </svg>
                    </button>

                </div>

                <div class="documents-extra-search-row">
                    <div class="field-wrapper">
                        <label for="form-search-document__doctype">Тип документа</label>
                        <div data-form-select class="form-field__select" id="form-search-document__doctype" name="doctype">
                            <input type="text" placeholder="Выберите тип документа" readonly name="documentType"/>
                            <ul class="options">
                                <li class="option-none">Все</li>
                                <li>Закон</li>
                                <li>Распоряжение</li>
                                <li>Постановление</li>
                                <li>Приказ</li>
                                <li>Протокол</li>
                                <li>Программа</li>
                            </ul>
                        </div>
                    </div>

                    <div class="field-wrapper">
                        <label for="form-search-document__author">Издатель документа</label>
                        <div data-form-select class="form-field__select" id="form-search-document__author">
                            <input type="text" placeholder="Выберите издателя документа" readonly name="documentPublisher"/>
                            <ul class="options">
                                <li class="option-none">Все</li>
                                <li>Правительство Российской Федерации</li>
                            </ul>
                        </div>
                    </div>

                    <div class="field-wrapper">
                        <label for="form-search-document__number">Номер</label>
                        <div data-form-select class="form-field__select" id="form-search-document__number" name="number">
                            <input type="text" placeholder="Выберите номер" readonly name="number"/>
                            <ul class="options">
                                <li class="option-none">Все</li>
                                {% for number in arResult['NUMBERS'] %}
                                    <li>{{ number }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>

                    <div class="field-wrapper">
                        <label for="form-search-document__date">Дата</label>
                        <input class="form-field__input" id="form-search-document__date" name="date" placeholder="За всё время">
                    </div>

                </div>

                <div class="documents-search-tags">
                    <div>
                        <button data-search-tag="Финансовая поддержка" class="search-tag button button_size-s button_theme-transparent" type="button">
                            Финансовая поддержка
                        </button>
                        <button data-search-tag="Имущественная поддержка" class="search-tag button button_size-s button_theme-transparent" type="button">
                            Имущественная поддержка
                        </button>
                        <button data-search-tag="Экспорт" class="search-tag button button_size-s button_theme-transparent" type="button">
                            Экспорт
                        </button>
                    </div>

                    <button data-btn-search-clear-params class="button button_theme-transparent button_padding-none documents-filter-button" type="button">
                        Сбросить всё
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M11.8409 3.19887C12.1061 2.93371 12.536 2.93371 12.8011 3.19887C13.0663 3.46403 13.0663 3.89394 12.8011 4.1591L8.9602 8.00005L12.8011 11.8409C13.0663 12.1061 13.0663 12.536 12.8011 12.8011C12.536 13.0663 12.1061 13.0663 11.8409 12.8011L7.99998 8.96027L4.15911 12.8011C4.15496 12.8053 4.15077 12.8094 4.14655 12.8134C3.88055 13.0662 3.45989 13.0621 3.19887 12.8011C3.00001 12.6023 2.95028 12.3107 3.04972 12.0655C3.08286 11.9838 3.13258 11.9072 3.19887 11.8409L7.03976 8.00005L3.19887 4.15913C2.93371 3.89397 2.93371 3.46406 3.19887 3.1989C3.46403 2.93374 3.89394 2.93374 4.1591 3.1989L7.99998 7.03976L11.8409 3.19887Z" fill="#4A66F5"/>
                        </svg>
                    </button>
                </div>

                <button class="search-button__mobile button button_size-m button_theme-blue" type="submit">
                    Найти
                </button>

                <div class="documents-filter-button__mobile">

                    <button data-btn-extra-search-params class="button button_theme-transparent button_padding-none documents-filter-button" type="button">
                        Расширенный поиск
                        <svg xmlns="http://www.w3.org/2000/svg" width="12" height="7" fill="none">
                            <path stroke="#4A66F5" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 1 6 6 1 1"/>
                        </svg>
                    </button>

                    <button data-btn-search-clear-params class="button button_theme-transparent button_padding-none documents-filter-button" type="button">
                        Сбросить всё
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M11.8409 3.19887C12.1061 2.93371 12.536 2.93371 12.8011 3.19887C13.0663 3.46403 13.0663 3.89394 12.8011 4.1591L8.9602 8.00005L12.8011 11.8409C13.0663 12.1061 13.0663 12.536 12.8011 12.8011C12.536 13.0663 12.1061 13.0663 11.8409 12.8011L7.99998 8.96027L4.15911 12.8011C4.15496 12.8053 4.15077 12.8094 4.14655 12.8134C3.88055 13.0662 3.45989 13.0621 3.19887 12.8011C3.00001 12.6023 2.95028 12.3107 3.04972 12.0655C3.08286 11.9838 3.13258 11.9072 3.19887 11.8409L7.03976 8.00005L3.19887 4.15913C2.93371 3.89397 2.93371 3.46406 3.19887 3.1989C3.46403 2.93374 3.89394 2.93374 4.1591 3.1989L7.99998 7.03976L11.8409 3.19887Z" fill="#4A66F5"/>
                        </svg>
                    </button>

                </div>

            </form>
        </div>
    </div>
</section>

<section class="section-not-found section section_padding-xxl">
    <div class="wrapper wrapper_mode-l">
        <div class="icon-block">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10.25 10C10.25 10.6904 9.69036 11.25 9 11.25C8.30964 11.25 7.75 10.6904 7.75 10C7.75 9.30965 8.30964 8.75 9 8.75C9.69036 8.75 10.25 9.30965 10.25 10Z" fill="white"/>
                <path d="M16.25 10C16.25 10.6904 15.6904 11.25 15 11.25C14.3096 11.25 13.75 10.6904 13.75 10C13.75 9.30965 14.3096 8.75 15 8.75C15.6904 8.75 16.25 9.30965 16.25 10Z" fill="white"/>
                <path d="M14.3691 15.775C14.6527 16.0769 15.1063 16.2074 15.4649 16C15.8234 15.7926 15.9501 15.329 15.6889 15.0075C14.8188 13.9362 13.4898 13.25 12 13.25C10.5102 13.25 9.18128 13.9362 8.3111 15.0075C8.04995 15.329 8.1766 15.7926 8.53515 16C8.89369 16.2074 9.34732 16.0769 9.63093 15.775C10.2243 15.1433 11.0665 14.75 12 14.75C12.9335 14.75 13.7757 15.1433 14.3691 15.775Z" fill="white"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22ZM12 20.5C16.6944 20.5 20.5 16.6944 20.5 12C20.5 7.30558 16.6944 3.5 12 3.5C7.30558 3.5 3.5 7.30558 3.5 12C3.5 16.6944 7.30558 20.5 12 20.5Z" fill="white"/>
            </svg>
        </div>

        <h2 class="headline headline_size-h2"></h2>
        <p class="description strong description_size-p1 description_padding-none">
            Попробуйте изменить условия поиска
        </p>
    </div>
</section>

<section class="section-documents show section section_padding-xs">
    <div class="wrapper wrapper_mode-l">
        <div class="document-list link-cards">
            {% endif %}
            {% for item in arResult['ITEMS'] %}
            <div class="link-cards__item column-2">
                <div class="link-cards__link link-cards__link-column">
                    <div class="link-cards__headline">
                        <p class="description strong description_size-p1 description_padding-none">{{ item['NAME'] }}</p>
                        <a download href="{{ item['file']['PROPERTY_VALUE'] }}" class="button button_theme-white button_size-s">
                            <div class="button__icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M12.7501 13.1893L15.9394 10C16.2323 9.70712 16.7071 9.70712 17 10C17.2929 10.2929 17.2929 10.7678 17 11.0607L12.5304 15.5303C12.3897 15.671 12.199 15.75 12.0001 15.75C11.8011 15.75 11.6104 15.671 11.4697 15.5303L7.00006 11.0606C6.70717 10.7678 6.70717 10.2929 7.00006 9.99998C7.29296 9.70708 7.76783 9.70708 8.06072 9.99998L11.2501 13.1893V2.75C11.2501 2.72411 11.2514 2.69853 11.2539 2.67332C11.2923 2.29513 11.6117 2 12.0001 2C12.4143 2 12.7501 2.33579 12.7501 2.75V13.1893Z" fill="#252830"/>
                                    <path d="M4.75 14.7503C4.75 14.336 4.41421 14.0003 4 14.0003C3.58578 14.0003 3.25 14.336 3.25 14.7503V19.0002C3.25 19.9667 4.0335 20.7502 5 20.7502H19C19.9665 20.7502 20.75 19.9667 20.75 19.0002V14.7503C20.75 14.336 20.4142 14.0003 20 14.0003C19.5858 14.0003 19.25 14.336 19.25 14.7503V19.0002C19.25 19.1383 19.138 19.2502 19 19.2502H5C4.86193 19.2502 4.75 19.1383 4.75 19.0002V14.7503Z" fill="#252830"/>
                                </svg>
                            </div>
                        </a>
                    </div>

                    <div class="document-info description_padding-top-s description_c-black-60 description_size-p3">
                        <span>{{ item['DATE_CREATE'] }}</span>    
                        {% if item['number']['PROPERTY_VALUE'] is not empty %}
                            <span>№{{ item['number']['PROPERTY_VALUE'] }}</span>
                        {% endif %}
                        {% if item['document_type']['PROPERTY_ENUM_VALUE'] is not empty %}
                            <span>{{ item['document_type']['PROPERTY_ENUM_VALUE'] }}</span>
                        {% endif %}
                        {% if item['document_publisher']['PROPERTY_ENUM_VALUE'] is not empty %}
                            <span>{{ item['document_publisher']['PROPERTY_ENUM_VALUE'] }}</span>
                        {% endif %}
                    </div>
                </div>
            </div>
            {% endfor %}
        {% if arResult['IS_AJAX'] is empty%}
        </div>
    </div>

</section>
{% if arResult['PAGES'] > 1 %}
    <section class="section-pagination show section section_padding-xl section_padding-top-none">
        <div class="wrapper wrapper_mode-l">
            <div class="pagination" id="pagination_news_list">
                <div class="pagination__item">
                    <a class="pagination__button pagination__button_prev" href="#"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none"><path fill="#252830" stroke="#4A66F5" d="M13.651 7.707a.25.25 0 1 0-.354-.354l-4.469 4.47a.25.25 0 0 0 0 .354l4.823-4.47Zm0 0-3.939 3.94-.354.353m4.293-4.293L9.358 12m0 0 .354.354M9.358 12l.354.354m0 0 3.94 3.939m-3.94-3.94 3.94 3.94m0 0a.25.25 0 0 1 0 .354v-.354Zm-.354.354-4.47-4.47 4.823 4.47a.25.25 0 0 1-.353 0Z"/></svg></a>
                </div>

                <div class="pagination__item" id="links">
                    {% for aItem in range(1, arResult['PAGES']) %}
                        <a class="pagination__link {{ aItem == arResult['PAGE'] ? 'pagination__link_current' : '' }}" href="#">{{ aItem }}</a>
                    {% endfor %}
                </div>

                <div class="pagination__item">
                    <a class="pagination__button pagination__button_next" href="#"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none"><path fill="#252830" stroke="#4A66F5" d="m14.656 12-.353.354-3.94 3.939a.25.25 0 0 0 0 .354M14.656 12l-3.586 5a.75.75 0 0 1-1.06 0l.353-.353M14.656 12l-.353-.353m.353.353-.353-.353m-3.94 5a.25.25 0 0 0 .354 0m-.354 0h.354m0 0 .353.353-.353-.354Zm0 0 4.47-4.47m-4.47 4.47 4.47-4.47m-.884-.53-3.94-3.94-.352.353.352-.353m3.94 3.94-3.94-3.94m5.177 3.763-.354.353-4.47-4.47a.25.25 0 0 0-.353 0m5.177 4.117-5.53-3.41a.75.75 0 0 1 0-1.06l.353.354m5.177 4.116-.354.353a.25.25 0 0 1 0 .354m.354-.707-.354.707m-4.823-4.823a.25.25 0 0 0 0 .353m0-.353v.353"/></svg></a>
                </div>
            </div>
        </div>
    </section>
{% endif %}
{% endif %}
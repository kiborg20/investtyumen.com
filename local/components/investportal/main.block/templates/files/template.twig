<section class="section section_padding-xl section_padding-top-none">
    <div class="wrapper wrapper_mode-l">
        {% if arResult['HEADER']['PREVIEW_TEXT'] is not empty %}
            <div class="headline headline_size-h2">{{ arResult['HEADER']['PREVIEW_TEXT'] }}</div>
        {% endif %}
        <div class="card card_theme-transparent">
            {% for file in arResult['HEADER']['files'] %}
                <div class="card__item card__item_column card__item_padding-none">
                    <div class="link-cards link-cards_one">
                        <div class="link-cards__item">
                            <a class="link-cards__link link-cards__link-column" href="{{ get_src_by_id(file['PROPERTY_VALUE']) }}">
                                <div class="link-cards__content">
                                    <div class="description description_size-p1 description_padding-none">{{ file['PROPERTY_DESCRIPTION'] }}</div>
                                    <div class="icon-block icon-block_theme-white icon-block_size-m"></div>
                                </div>    
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<section class="section section_padding-xl section_padding-bottom-none">
    <div class="wrapper {{ arResult['ITEM']['IS_SMALL'] is empty ? 'wrapper_mode-l' : 'wrapper_mode-s' }}">
        <div class="block__limited-width-m no-margin">
            <h1 class="headline headline_size-h1">{{ arResult['ITEM']['NAME'] }}</h1>
            {% if (arResult['ITEM']['DETAIL_TEXT'] is not empty) %}
                <div class="description description_size-p1 description_padding-bottom-none">
                    {{ arResult['ITEM']['DETAIL_TEXT'] | raw }}
                </div>
            {% endif %}
        </div>
    </div>
</section>

{% if arResult['ITEM']['PREVIEW_PICTURE'] is not empty %}
<section class="section section_padding-m section_padding-bottom-none">
    <div class="wrapper wrapper_mode-l">
        <div class="image-container image-container_bg full-image" style="background-image: url({{get_src_by_id(arResult['ITEM']['PREVIEW_PICTURE'])}})"></div>
    </div>
</section>
{% endif %}
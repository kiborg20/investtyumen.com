<section id="{{ arResult.ITEMS|first.taghref }}" class="section section_padding-xl">
    <div class="wrapper wrapper_mode-l">
        <div class="factoids">
        {% for item in arResult.ITEMS %}
            {% if item.iconBlock_1 is not empty %}
            <div class="factoids__item">
                <div class="factoids__icon">
                    <div class="icon-block">{{ item.iconBlock_1 | raw }}</div>
                </div>

                <div class="factoids__content">
                    <div class="factoids__title">
                        <span>{{ item.numberBlock_1 | raw }}</span> {{ item.measureBlock_1 }}
                    </div>
                    <div class="factoids__text">{{ item.descBlock_1 | raw }}</div>
                </div>
            </div>
            {% endif %}

            {% if item.iconBlock_2 is not empty %}
            <div class="factoids__item">
                <div class="factoids__icon">
                    <div class="icon-block">{{ item.iconBlock_2 | raw}}</div>
                </div>

                <div class="factoids__content">
                    <div class="factoids__title">
                        <span>{{ item.numberBlock_2 | raw }}</span> {{ item.measureBlock_2 }}
                    </div>
                    <div class="factoids__text">{{ item.descBlock_2 | raw }}</div>
                </div>
            </div>
            {% endif %}

            {% if item.iconBlock_3 is not empty %}
            <div class="factoids__item">
                <div class="factoids__icon">
                    <div class="icon-block">{{ item.iconBlock_3 | raw}}</div>
                </div>

                <div class="factoids__content">
                    <div class="factoids__title">
                        <span>{{ item.numberBlock_3 | raw }}</span> {{ item.measureBlock_3 }}
                    </div>
                    <div class="factoids__text">{{ item.descBlock_3 | raw }}</div>
                </div>
            </div>
            {% endif %}
        {% endfor %}
        </div>
    </div>
</section>

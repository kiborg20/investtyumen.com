# Bitrix: исключаем /bitrix кроме нужных подпапок
!/bitrix
/bitrix/*

# печатные формы интернет-магазина
!/bitrix/admin/
/bitrix/admin/*
!/bitrix/admin/reports/

# нестандартные компоненты
!/bitrix/components/
/bitrix/components/bitrix/

# php_interface (кроме конфигов окружения и логов)
!/bitrix/php_interface/
/bitrix/php_interface/dbconn.ph*
/bitrix/php_interface/after_connect*
/bitrix/php_interface/logs/

# шаблоны сайта
!/bitrix/templates/

# local: логи и загрузки
/local/php_interface/logs/
/local/logs/
/upload/

# отдельный git-репозиторий фронтенда (Vite + Twig)
/local/frontend/

# disable tracking Redis
/local/.settings_extra.php

# системные папки и файлы хостингов и ОС
/cgi-bin/
/awstats/
/webstat/
.DS_Store
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# текстовые и подобные ресурсы (на практике обычно излишни)
*.xml
*.html
*.txt
*.log*
*.css.map
# возвращаем файлы миграций
!local/php_interface/migrations/*/*.xml

# архивы, включая многотомные
*.zip
*.zip*
*.tar
*.tar*
*.enc
*.enc*
*.gz
*.gz*
*.tgz
*.tgz*
*.sql
*.rar
.hg
.ftpconfig
*.doc
*.docx
*.pdf
*.rtf
*.xls
*.xlsx
*.ppt
*.pptx
*.psd
*.psb
*.sketch
*.yml
core.*

# однако храним robots.txt — он нужен
!/robots.txt

# composer
composer.phar
/vendor/

# node.js
node_modules
bower_components
.grunt
.npm
.env

# стандартные библиотеки
/PHPMailer

# xhprof
/xhprof/logs

# загружаемые файлы в чат-ботах
/telegrambot/Download/
/telegrambot/Upload/
/viberbot/Download/
/viberbot/Upload/

# htaccess и файлы верификации поисковиков
.htaccess
.htaccess*
.htaccess.restore
.htsecure
yandex*
google*

# тестовые и временные файлы
/test/tmp.php
